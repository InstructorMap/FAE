<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Súper Panel FAE · Federación Argentina de Educación</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: #020617; color: #e2e8f0; }
        /* Tonos dorados/azules para FAE */
        .sidebar-link { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 8px; transition: all 0.2s; color: #94a3b8; cursor: pointer; }
        .sidebar-link:hover, .sidebar-link.active { background: #1e293b; color: white; }
        .sidebar-link.active { border-left: 3px solid #d97706; /* Dorado FAE */ } 
        .card { background: #0f172a; border: 1px solid #1e293b; border-radius: 12px; padding: 24px; }
        .tab-content { display: none; }
        .tab-content.active { display: block; animation: fadeIn 0.3s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
        
        input[type="text"], input[type="number"], input[type="url"], input[type="color"], select {
            width: 100%; background: #1e293b; border: 1px solid #334155; 
            border-radius: 8px; padding: 10px; color: white; outline: none; transition: border-color 0.2s;
        }
        input:focus, select:focus { border-color: #d97706; }
        label { display: block; font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 6px; }
        .spinner { border: 2px solid rgba(255,255,255,0.1); border-left-color: white; border-radius: 50%; width: 16px; height: 16px; animation: spin 1s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body class="h-screen flex overflow-hidden">

    <aside class="w-64 bg-slate-950 border-r border-slate-900 flex flex-col z-20 hidden md:flex">
        <div class="h-28 flex flex-col justify-center px-6 border-b border-slate-900 gap-1">
            <div class="flex items-center gap-2 text-yellow-500 font-black tracking-widest text-xl">
                <i data-lucide="book-open" class="text-white"></i> F.A.E.
            </div>
            <span class="text-[10px] text-slate-400 font-bold leading-tight">Federación Argentina<br>de Educación</span>
            <span class="text-[9px] text-slate-600 font-mono mt-1">Acta N° 4651912 INPI</span>
        </div>
        <nav class="flex-1 p-4 space-y-2 overflow-y-auto">
            <div class="px-2 py-2 text-[10px] font-bold text-slate-600 uppercase tracking-widest mt-2">Centro de Comando</div>
            <button onclick="showTab('dashboard')" id="nav-dashboard" class="sidebar-link active w-full"><i data-lucide="layout-dashboard" class="w-5 h-5"></i> Dashboard Global</button>
            <button onclick="showTab('matriculados')" id="nav-matriculados" class="sidebar-link w-full"><i data-lucide="users" class="w-5 h-5"></i> Padrón Nacional</button>
            
            <div class="px-2 py-2 text-[10px] font-bold text-slate-600 uppercase tracking-widest mt-6">Ecosistema FAE</div>
            <button onclick="showTab('registros')" id="nav-registros" class="sidebar-link w-full text-yellow-500"><i data-lucide="network" class="w-5 h-5"></i> Registros y Sedes</button>
            <button onclick="showTab('avales')" id="nav-avales" class="sidebar-link w-full"><i data-lucide="award" class="w-5 h-5"></i> Partners y Avales</button>

            <div class="px-2 py-2 text-[10px] font-bold text-slate-600 uppercase tracking-widest mt-6">Configuración</div>
            <button onclick="showTab('identidad')" id="nav-identidad" class="sidebar-link w-full"><i data-lucide="settings" class="w-5 h-5"></i> Web & Pagos</button>
        </nav>
        <div class="p-4 border-t border-slate-900">
            <a href="index.html" target="_blank" class="flex items-center gap-2 text-xs font-bold text-slate-500 hover:text-white transition-colors"><i data-lucide="external-link" class="w-4 h-4"></i> IR AL PORTAL FAE</a>
        </div>
    </aside>

    <main class="flex-1 flex flex-col min-w-0 bg-slate-950">
        <header class="h-16 bg-slate-950 border-b border-slate-900 flex justify-between items-center px-8">
            <div class="flex items-center gap-4">
                <button class="md:hidden text-slate-400"><i data-lucide="menu"></i></button>
                <h2 class="text-xl font-black text-white uppercase tracking-wider" id="page-title">Dashboard Global</h2>
            </div>
            <div class="flex gap-3">
                <button onclick="saveConfigCloud()" id="btn-save-cloud" class="bg-yellow-600 hover:bg-yellow-500 text-white font-bold py-2 px-4 rounded-lg transition-all flex items-center gap-2 text-sm shadow-lg shadow-yellow-900/20"><i data-lucide="cloud-upload" class="w-4 h-4"></i> GUARDAR CAMBIOS</button>
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-6 md:p-8">

            <div id="view-dashboard" class="tab-content active space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div class="card bg-gradient-to-br from-slate-900 to-slate-900 border-l-4 border-l-blue-500 relative overflow-hidden">
                        <i data-lucide="users" class="absolute -right-4 -bottom-4 w-24 h-24 text-white/5"></i>
                        <p class="text-slate-400 text-xs font-bold uppercase relative z-10">Total Profesionales</p>
                        <h3 class="text-4xl font-black text-white mt-1 relative z-10" id="dash-total-alumnos">---</h3>
                    </div>
                    <div class="card bg-gradient-to-br from-slate-900 to-slate-900 border-l-4 border-l-emerald-500">
                        <p class="text-slate-400 text-xs font-bold uppercase">Registros Activos</p>
                        <h3 class="text-4xl font-black text-white mt-1" id="dash-total-registros">---</h3>
                    </div>
                    <div class="card bg-gradient-to-br from-slate-900 to-slate-900 border-l-4 border-l-purple-500">
                        <p class="text-slate-400 text-xs font-bold uppercase">Trámites Pendientes</p>
                        <h3 class="text-4xl font-black text-white mt-1" id="dash-total-solicitudes">0</h3>
                    </div>
                    <div class="card bg-gradient-to-br from-slate-900 to-slate-900 border-l-4 border-l-yellow-500">
                        <p class="text-slate-400 text-xs font-bold uppercase">Proyección ($)</p>
                        <h3 class="text-3xl font-black text-yellow-500 mt-1" id="dash-total-ingresos">$0</h3>
                    </div>
                </div>

                <div class="card">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="font-bold text-lg text-white flex items-center gap-2"><i data-lucide="inbox" class="text-purple-500"></i> Buzón de Trámites (Central)</h3>
                        <button onclick="descargarExcelSolicitudes()" class="bg-green-700 hover:bg-green-600 text-white text-xs font-bold py-2 px-3 rounded flex items-center gap-2">
                            <i data-lucide="file-spreadsheet" class="w-4 h-4"></i> EXPORTAR EXCEL
                        </button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-slate-900 text-slate-400 border-b border-slate-800">
                                <tr>
                                    <th class="p-3">Fecha</th>
                                    <th class="p-3">Solicitante</th>
                                    <th class="p-3">Contacto</th>
                                    <th class="p-3">Estado</th>
                                    <th class="p-3">Documentos</th>
                                </tr>
                            </thead>
                            <tbody id="crm-body" class="divide-y divide-slate-800 text-slate-300">
                                <tr><td colspan="5" class="p-4 text-center text-slate-500">Cargando solicitudes...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div id="view-matriculados" class="tab-content space-y-6">
                <div class="flex justify-between items-center">
                    <h3 class="text-lg font-bold">Padrón Nacional (Todos los Registros)</h3>
                    <button onclick="document.getElementById('modal-alumno').classList.remove('hidden'); cargarInstitucionesSelect();" class="bg-blue-600 hover:bg-blue-500 text-white font-bold py-2 px-4 rounded-lg flex items-center gap-2 text-sm"><i data-lucide="user-plus"></i> NUEVO PROFESIONAL</button>
                </div>
                <div class="card p-0 overflow-hidden">
                    <table class="w-full text-left text-sm"><thead class="bg-slate-900 text-slate-400 border-b border-slate-800"><tr><th class="p-4">Profesional</th><th class="p-4">DNI / Matrícula</th><th class="p-4">Registro Perteneciente</th><th class="p-4 text-right">Acciones</th></tr></thead><tbody id="lista-alumnos" class="divide-y divide-slate-800 text-slate-300"></tbody></table>
                </div>
            </div>

            <div id="view-registros" class="tab-content space-y-6">
                <div class="card bg-slate-900 border border-yellow-900/50">
                    <h3 class="font-bold text-lg text-white mb-4 flex items-center gap-2"><i data-lucide="plus-circle" class="text-yellow-500"></i> Crear Nuevo Registro Oficial</h3>
                    <p class="text-xs text-slate-400 mb-6">Al crear un registro aquí (Ej: REMPE, REMAEP), se generará automáticamente su página de inicio y se le asignará una base de datos aislada para sus profesionales.</p>
                    
                    <form id="form-registro" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                        <div class="col-span-1 md:col-span-2">
                            <label>Nombre Completo (Ej: Registro Estética)</label>
                            <input type="text" id="reg-nombre" required>
                        </div>
                        <div>
                            <label>Sigla / URL (Ej: rempe)</label>
                            <input type="text" id="reg-sigla" class="font-mono text-yellow-500" required>
                        </div>
                        <div>
                            <label>Color Principal</label>
                            <input type="color" id="reg-color" class="h-[42px] cursor-pointer" value="#3b82f6">
                        </div>
                        <div class="col-span-1 md:col-span-3">
                            <label>Logo del Registro (PNG Transparente)</label>
                            <input type="file" id="reg-logo" class="text-sm text-slate-400" accept="image/*">
                        </div>
                        <div class="col-span-1 text-right">
                            <button type="submit" class="w-full bg-yellow-600 hover:bg-yellow-500 text-white font-bold py-2.5 px-4 rounded-lg transition shadow-lg">CREAR REGISTRO</button>
                        </div>
                    </form>
                </div>
                
                <h3 class="font-bold text-white mt-8 mb-4">Registros Activos en la Red FAE</h3>
                <div id="grid-registros" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    </div>
            </div>

            <div id="view-avales" class="tab-content space-y-6">
                <div class="card bg-slate-900 border border-slate-700">
                    <h3 class="font-bold text-lg text-white mb-4 flex items-center gap-2"><i data-lucide="award" class="text-emerald-500"></i> Entidades Avaladoras</h3>
                    <form id="form-partner" class="flex flex-col md:flex-row gap-4 items-end">
                        <div class="flex-1 w-full"><label>Nombre Institución</label><input type="text" id="partner-nombre" required></div>
                        <div class="flex-1 w-full"><label>Logo (PNG/JPG)</label><input type="file" id="partner-logo" class="text-sm text-slate-400" required></div>
                        <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 px-6 rounded-lg transition">Publicar</button>
                    </form>
                </div>
                <div id="grid-partners" class="grid grid-cols-2 md:grid-cols-4 gap-4"></div>
            </div>

            <div id="view-identidad" class="tab-content space-y-6 max-w-4xl">
                <div class="card">
                    <h3 class="font-bold text-lg text-white mb-4 border-b border-slate-800 pb-2">Configuración del Portal Central FAE</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-4">
                            <div><label>Nombre Portal (Se ve en la pestaña)</label><input type="text" id="conf-title"></div>
                            <div><label>Título Principal (Hero)</label><input type="text" id="conf-hero-title"></div>
                            <div><label>Texto del Botón Principal</label><input type="text" id="conf-cta"></div>
                        </div>
                        <div class="space-y-4">
                            <div><label>WhatsApp Soporte FAE (Sin +)</label><input type="text" id="conf-whatsapp"></div>
                            <div><label>Precio Único de Homologación ($)</label><input type="number" id="conf-price" class="text-emerald-400 font-bold"></div>
                            <div><label>Link Mercado Pago (Checkout)</label><input type="url" id="conf-mplink"></div>
                        </div>
                    </div>
                    <div class="mt-6 space-y-4 pt-6 border-t border-slate-800">
                        <p class="text-xs text-yellow-500 font-bold uppercase mb-2">Imágenes Globales</p>
                        <div>
                            <label>Logo Central FAE</label>
                            <div class="flex gap-2"><input type="text" id="conf-logo" placeholder="URL" class="flex-1"><label class="cursor-pointer bg-slate-800 px-3 py-2 rounded-lg border border-slate-700"><i data-lucide="upload" class="w-4 h-4 text-white"></i><input type="file" id="conf-logo-upload" class="hidden" accept="image/*"></label></div>
                        </div>
                        <div>
                            <label>Imagen de Fondo Principal</label>
                            <div class="flex gap-2"><input type="text" id="conf-banner" placeholder="URL" class="flex-1"><label class="cursor-pointer bg-slate-800 px-3 py-2 rounded-lg border border-slate-700"><i data-lucide="upload" class="w-4 h-4 text-white"></i><input type="file" id="conf-banner-upload" class="hidden" accept="image/*"></label></div>
                        </div>
                        <input type="hidden" id="conf-color" value="#0f172a"> </div>
                </div>
            </div>

        </div>
    </main>

    <div id="modal-alumno" class="fixed inset-0 bg-black/80 hidden flex items-center justify-center z-50 backdrop-blur-sm">
        <div class="bg-slate-900 p-8 rounded-2xl w-full max-w-lg border border-slate-700 shadow-2xl relative">
            <button onclick="document.getElementById('modal-alumno').classList.add('hidden')" class="absolute top-4 right-4 text-slate-400 hover:text-white"><i data-lucide="x"></i></button>
            <h3 class="text-xl font-bold mb-6 text-white">Alta de Profesional</h3>
            <form id="form-alumno" class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div><label>Nombre</label><input type="text" id="al-nombre" required></div>
                    <div><label>Apellido</label><input type="text" id="al-apellido" required></div>
                </div>
                <div><label>DNI</label><input type="text" id="al-dni" required></div>
                <div><label>Certificación / Curso</label><input type="text" id="al-curso" required></div>
                <div>
                    <label>Asignar a Registro (Obligatorio)</label>
                    <select id="al-institucion" class="bg-slate-950 text-white p-2.5 rounded-lg border border-slate-700 w-full" required>
                        <option value="">Seleccione a qué registro pertenece...</option>
                    </select>
                </div>
                <div class="flex justify-end mt-6">
                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-lg shadow-lg">Registrar Profesional</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // CONFIGURACIÓN SUPABASE (TUS CREDENCIALES)
        const PROJECT_URL = 'https://vxggatcfrywyodovjwxj.supabase.co';
        const PUBLIC_KEY  = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ4Z2dhdGNmcnl3eW9kb3Zqd3hqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjgyMzM5MjgsImV4cCI6MjA4MzgwOTkyOH0.RZ9jhEASO6nCV8EnzrHQBhglP4G1nik9Z5osPXysGNg';
        const db = supabase.createClient(PROJECT_URL, PUBLIC_KEY);

        let globalPrecio = 0;

        function showTab(id) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.sidebar-link').forEach(el => el.classList.remove('active'));
            document.getElementById('view-' + id).classList.add('active');
            document.getElementById('nav-' + id).classList.add('active');
            
            const titles = { 'dashboard': 'Dashboard Global', 'matriculados': 'Padrón Nacional', 'registros': 'Ecosistema de Registros', 'avales': 'Partners Institucionales', 'identidad': 'Configuración del Portal' };
            document.getElementById('page-title').textContent = titles[id] || id;

            if(id === 'matriculados') cargarAlumnos();
            if(id === 'registros') cargarRegistrosActivos();
            if(id === 'avales') cargarPartners();
        }

        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            loadCloudConfig(); 
            loadCRM();          
            updateDashboardStats(); 
            cargarInstitucionesSelect();
        });

        // --- GESTIÓN DE CONFIGURACIÓN ---
        async function loadCloudConfig() {
            try {
                const { data } = await db.from('configuracion_sitios_oficiales').select('*').eq('id', 1).single();
                if (data) {
                    setVal('conf-title', data.titulo);
                    setVal('conf-color', data.color);
                    setVal('conf-hero-title', data.hero_title);
                    setVal('conf-cta', data.cta_text);
                    setVal('conf-price', data.precio);
                    setVal('conf-mplink', data.mp_link);
                    setVal('conf-logo', data.logo_url);
                    setVal('conf-banner', data.banner_url);
                    setVal('conf-whatsapp', data.whatsapp);
                    globalPrecio = parseFloat(data.precio) || 0;
                }
            } catch (err) { console.error(err); }
        }

        async function saveConfigCloud() {
            const btn = document.getElementById('btn-save-cloud');
            const originalText = btn.innerHTML;
            btn.innerHTML = "Guardando..."; btn.disabled = true;

            const configData = {
                id: 1, 
                titulo: document.getElementById('conf-title').value,
                hero_title: document.getElementById('conf-hero-title').value,
                cta_text: document.getElementById('conf-cta').value,
                logo_url: document.getElementById('conf-logo').value,
                banner_url: document.getElementById('conf-banner').value,
                color: document.getElementById('conf-color').value,
                precio: document.getElementById('conf-price').value,
                mp_link: document.getElementById('conf-mplink').value,
                whatsapp: document.getElementById('conf-whatsapp').value
            };

            const { error } = await db.from('configuracion_sitios_oficiales').upsert(configData);
            
            btn.innerHTML = originalText; btn.disabled = false;
            if(!error) {
                alert("¡Configuración guardada en FAE!");
                globalPrecio = parseFloat(configData.precio) || 0;
                updateDashboardStats(); 
            } else alert("Error: " + error.message);
        }

        // --- SOLICITUDES Y EXCEL ---
        async function loadCRM() {
            const tbody = document.getElementById('crm-body');
            tbody.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-slate-500"><div class="spinner mx-auto"></div></td></tr>';

            try {
                const { data: reqs, error } = await db.from('solicitudes_tramites').select('*').order('created_at', { ascending: false });
                if(error) throw error;

                document.getElementById('dash-total-solicitudes').innerText = reqs.length;
                const totalIngresos = reqs.length * globalPrecio;
                document.getElementById('dash-total-ingresos').innerText = "$" + new Intl.NumberFormat('es-AR').format(totalIngresos);

                if(reqs && reqs.length > 0) {
                    tbody.innerHTML = reqs.slice(0, 50).map(r => `
                        <tr class="hover:bg-slate-800/50 transition border-b border-slate-800">
                            <td class="p-3 text-xs text-slate-500">${new Date(r.created_at).toLocaleDateString()}</td>
                            <td class="p-3 font-bold text-white">
                                ${r.nombre} ${r.apellido}
                                <div class="text-[10px] text-slate-500 font-normal">${r.curso}</div>
                            </td>
                            <td class="p-3 text-xs text-slate-400">
                                <div class="font-mono mb-1">📞 <a href="https://wa.me/${r.telefono.replace(/\D/g,'')}" target="_blank" class="hover:text-green-400">${r.telefono}</a></div>
                                <div class="truncate w-32" title="${r.email}">📧 ${r.email}</div>
                            </td>
                            <td class="p-3">
                                <span class="bg-yellow-500/20 text-yellow-400 text-[10px] px-2 py-1 rounded font-bold uppercase tracking-wider">${r.estado || 'PENDIENTE'}</span>
                            </td>
                            <td class="p-3 flex gap-2">
                                ${r.archivo_dni_url ? `<a href="${r.archivo_dni_url}" target="_blank" class="bg-slate-800 p-1.5 rounded hover:bg-blue-600 transition" title="Ver DNI"><i data-lucide="id-card" class="w-4 h-4 text-white"></i></a>` : ''}
                                ${r.archivo_diploma_url ? `<a href="${r.archivo_diploma_url}" target="_blank" class="bg-slate-800 p-1.5 rounded hover:bg-emerald-600 transition" title="Ver Diploma"><i data-lucide="file-check" class="w-4 h-4 text-white"></i></a>` : ''}
                            </td>
                        </tr>
                    `).join('');
                    lucide.createIcons();
                } else {
                    tbody.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-slate-500">No hay solicitudes nuevas.</td></tr>';
                }
            } catch(e) { tbody.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-red-500">Error cargando buzón.</td></tr>'; }
        }

        async function descargarExcelSolicitudes() {
            try {
                const { data: reqs } = await db.from('solicitudes_tramites').select('*').order('created_at', { ascending: false });
                if (!reqs || reqs.length === 0) return alert("No hay datos.");
                const datosExcel = reqs.map(r => ({
                    Fecha: new Date(r.created_at).toLocaleDateString(), Nombre: r.nombre, Apellido: r.apellido,
                    DNI: r.dni, Curso: r.curso, Celular: r.telefono, Email: r.email, Estado: r.estado,
                    Link_DNI: r.archivo_dni_url, Link_Diploma: r.archivo_diploma_url
                }));
                const ws = XLSX.utils.json_to_sheet(datosExcel);
                const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, "Trámites FAE");
                XLSX.writeFile(wb, `Tramites_FAE_${new Date().toISOString().slice(0,10)}.xlsx`);
            } catch (e) { alert("Error Excel: " + e.message); }
        }

        // --- GESTIÓN DE REGISTROS (NUEVO) ---
        async function cargarRegistrosActivos() {
            const grid = document.getElementById('grid-registros');
            grid.innerHTML = '<div class="col-span-3 text-center py-4 text-slate-500"><div class="spinner mx-auto mb-2"></div>Cargando Ecosistema...</div>';
            
            const { data, error } = await db.from('instituciones').select('*').order('nombre');
            
            if(data) {
                document.getElementById('dash-total-registros').innerText = data.length;
                grid.innerHTML = data.map(r => `
                    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 flex items-center gap-4 relative group">
                        <div class="w-12 h-12 rounded-lg bg-white/5 flex items-center justify-center shrink-0 border" style="border-color: ${r.color_tema || '#333'}">
                            ${r.logo_url ? `<img src="${r.logo_url}" class="w-full h-full object-contain p-1">` : `<i data-lucide="shield" class="text-slate-400"></i>`}
                        </div>
                        <div class="min-w-0">
                            <h4 class="font-bold text-white truncate text-sm">${r.nombre}</h4>
                            <p class="text-[10px] text-slate-400 font-mono uppercase mt-0.5">SIGLA: ${r.sigla || 'N/A'}</p>
                            <a href="registro.html?id=${r.sigla}" target="_blank" class="text-[10px] text-blue-400 hover:underline mt-1 inline-block">Ver Portal Propio</a>
                        </div>
                        <button onclick="borrarRegistro('${r.id}')" class="absolute top-2 right-2 text-slate-600 hover:text-red-500 opacity-0 group-hover:opacity-100 transition"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                    </div>
                `).join('');
                lucide.createIcons();
            }
        }

        document.getElementById('form-registro').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button'); btn.innerText = "..."; btn.disabled = true;
            try {
                const nombre = document.getElementById('reg-nombre').value;
                const sigla = document.getElementById('reg-sigla').value.toLowerCase().replace(/\s+/g, '');
                const color = document.getElementById('reg-color').value;
                const file = document.getElementById('reg-logo').files[0];
                
                let logoUrl = null;
                if(file) {
                    const fileName = `reg_${sigla}_${Date.now()}.${file.name.split('.').pop()}`;
                    await db.storage.from('logos-instituciones').upload(fileName, file);
                    logoUrl = `${PROJECT_URL}/storage/v1/object/public/logos-instituciones/${fileName}`;
                }

                const { error } = await db.from('instituciones').insert([{ 
                    nombre: nombre, sigla: sigla, color_tema: color, color_primario: color, logo_url: logoUrl, activo: true 
                }]);
                
                if(error) throw error;
                e.target.reset(); cargarRegistrosActivos(); cargarInstitucionesSelect(); alert("¡Registro creado en la red FAE!");
            } catch (err) { alert("Error: " + err.message); } finally { btn.innerText = "CREAR REGISTRO"; btn.disabled = false; }
        });

        async function borrarRegistro(id) { if(confirm('¿Borrar Registro? Esta acción no se puede deshacer.')) { await db.from('instituciones').delete().eq('id', id); cargarRegistrosActivos(); cargarInstitucionesSelect(); } }

        // --- ALUMNOS Y PARTNERS (EXISTENTE) ---
        async function cargarAlumnos() {
            const lista = document.getElementById('lista-alumnos');
            const { data } = await db.from('matriculas').select('*, instituciones(nombre, sigla)').order('created_at', { ascending: false }).limit(100);
            if (data) lista.innerHTML = data.map(al => `
                <tr class="hover:bg-slate-800/50 border-b border-slate-800/50">
                    <td class="p-4"><div class="font-bold text-white">${al.nombre} ${al.apellido}</div><div class="text-xs text-slate-500">${al.curso}</div></td>
                    <td class="p-4 font-mono text-xs text-slate-400">${al.dni_alumno}</td>
                    <td class="p-4 text-xs font-bold"><span class="bg-slate-800 px-2 py-1 rounded text-slate-300 uppercase border border-slate-700">${al.instituciones?.sigla || 'FAE'}</span></td>
                    <td class="p-4 text-right"><a href="https://asari-platform.vercel.app/validador.html?id=${al.id}" target="_blank" class="text-blue-400 hover:text-white text-xs font-bold border border-blue-900/50 px-2 py-1 rounded bg-blue-900/20">Validador ID</a></td>
                </tr>`).join('');
        }

        async function cargarInstitucionesSelect() {
            const s = document.getElementById('al-institucion');
            const { data } = await db.from('instituciones').select('id, nombre, sigla');
            if(data) s.innerHTML = '<option value="">-- Seleccionar Registro Base --</option>' + data.map(i => `<option value="${i.id}">[${(i.sigla||'').toUpperCase()}] ${i.nombre}</option>`).join('');
        }

        document.getElementById('form-alumno').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]'); btn.disabled = true;
            const instId = document.getElementById('al-institucion').value;
            if(!instId) { alert("Debes seleccionar un Registro al cual pertenece el profesional."); btn.disabled = false; return; }

            // Buscar la sigla para guardarla en la matrícula
            const { data: instData } = await db.from('instituciones').select('sigla').eq('id', instId).single();

            const datos = { 
                nombre: document.getElementById('al-nombre').value, 
                apellido: document.getElementById('al-apellido').value, 
                dni_alumno: document.getElementById('al-dni').value, 
                curso: document.getElementById('al-curso').value, 
                institucion_id: instId,
                registro_id: instData ? instData.sigla : 'fae' // Guardar la sigla directamente
            };
            const { error } = await db.from('matriculas').insert([datos]);
            if(!error) { document.getElementById('modal-alumno').classList.add('hidden'); document.getElementById('form-alumno').reset(); cargarAlumnos(); updateDashboardStats(); }
            else alert(error.message);
            btn.disabled = false;
        });

        // Partners Index
        async function cargarPartners() {
            const grid = document.getElementById('grid-partners');
            const { data } = await db.from('partners').select('*').order('created_at', { ascending: false });
            if (data) grid.innerHTML = data.map(p => `<div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-col items-center gap-3 relative group"><button onclick="borrarPartner('${p.id}')" class="absolute top-2 right-2 text-slate-400 hover:text-red-500 p-1 opacity-0 group-hover:opacity-100 transition"><i data-lucide="trash-2" size="16"></i></button><div class="h-16 w-full flex items-center justify-center bg-white/5 rounded-lg p-2"><img src="${p.logo_url}" class="max-h-full object-contain"></div><span class="text-[10px] font-bold text-center text-slate-400 uppercase">${p.nombre}</span></div>`).join('');
            lucide.createIcons();
        }
        document.getElementById('form-partner').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button'); btn.innerText = "..."; btn.disabled = true;
            try {
                const nombre = document.getElementById('partner-nombre').value;
                const file = document.getElementById('partner-logo').files[0];
                const fileName = `partner_${Date.now()}.${file.name.split('.').pop()}`;
                await db.storage.from('logos-partners').upload(fileName, file);
                const logoUrl = `${PROJECT_URL}/storage/v1/object/public/logos-partners/${fileName}`;
                await db.from('partners').insert([{ nombre, logo_url: logoUrl }]);
                e.target.reset(); cargarPartners();
            } catch (err) { alert("Error: " + err.message); } finally { btn.innerText = "Publicar"; btn.disabled = false; }
        });
        async function borrarPartner(id) { if(confirm('¿Borrar?')) { await db.from('partners').delete().eq('id', id); cargarPartners(); } }

        // Utils
        async function updateDashboardStats() {
            const { count: c1 } = await db.from('matriculas').select('*', { count: 'exact', head: true });
            const { count: c2 } = await db.from('instituciones').select('*', { count: 'exact', head: true });
            document.getElementById('dash-total-alumnos').innerText = c1 || 0;
            if(document.getElementById('dash-total-registros').innerText === '---') document.getElementById('dash-total-registros').innerText = c2 || 0;
        }

        async function uploadImage(file, inputId) {
            if(!file) return;
            const fileName = `global_${Date.now()}.${file.name.split('.').pop()}`;
            try {
                const { error } = await db.storage.from('logos-instituciones').upload(fileName, file);
                if(error) throw error;
                const url = `${PROJECT_URL}/storage/v1/object/public/logos-instituciones/${fileName}`;
                document.getElementById(inputId).value = url;
                alert("Imagen subida. Dale a 'GUARDAR CAMBIOS'.");
            } catch (err) { alert("Error: " + err.message); }
        }
        document.getElementById('conf-banner-upload').addEventListener('change', (e) => uploadImage(e.target.files[0], 'conf-banner'));
        document.getElementById('conf-logo-upload').addEventListener('change', (e) => uploadImage(e.target.files[0], 'conf-logo'));
        function setVal(id, v) { if(v) document.getElementById(id).value = v; }
    </script>
</body>
</html>
